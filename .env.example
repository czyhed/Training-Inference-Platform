# Storage selection: use postgres in the CPU-server deployment.
XUNTUI_STORAGE_BACKEND=postgres
XUNTUI_SHARED_STORAGE_ENABLED=true
XUNTUI_INFERENCE_AUTO_RECOVERY=true
XUNTUI_INFERENCE_IDLE_RECLAIMER=true
XUNTUI_INFERENCE_IDLE_CHECK_SECONDS=30
POSTGRES_DSN=postgresql://cppt_platform_app:replace-me@postgres-host:5432/cppt_platform
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=6
POSTGRES_POOL_TIMEOUT=3
POSTGRES_POOL_MAX_WAITING=32
POSTGRES_POOL_MAX_IDLE=300
POSTGRES_POOL_MAX_LIFETIME=1800
POSTGRES_CONNECT_TIMEOUT=5

# Object storage; secrets are injected by Docker Compose / Drone rather than committed.
MINIO_ENDPOINT=minio-host:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=rag-assets
MINIO_SECURE=false
MODEL_UPLOAD_USER=local-admin

# CPU-server paths and internal service port. Do not use Windows paths in production.
XUNTUI_RUNTIME_ROOT=/workspace/runtime
XUNTUI_ARTIFACT_ROOT=/workspace/artifacts
XUNTUI_DATASET_ROOT=/workspace/datasets
XUNTUI_DATABASE_PATH=/workspace/runtime/compatibility.db
XUNTUI_MODELSCOPE_CACHE=/workspace/model-cache
XUNTUI_TRAINING_WORKDIR=/workspace/training-work
# Used only when the command is an explicit `.py` script or starts with `-m`.
XUNTUI_TRAINING_PYTHON=/opt/venvs/llamafactory/bin/python
XUNTUI_CORS_ORIGINS=https://example.com
XUNTUI_BACKEND_HOST=0.0.0.0
XUNTUI_BACKEND_PORT=8010
XUNTUI_LOG_LEVEL=info
XUNTUI_INFERENCE_PORT=8011

# Control Center OAuth2 client (registered application key: cppt-platform).
XUNTUI_AUTH_MODE=disabled
CONTROL_CENTER_URL=http://185.61.210.32
OAUTH_AUTHORIZE_URL=http://185.61.210.32/api/oauth/authorize
OAUTH_TOKEN_URL=http://185.61.210.32/api/oauth/token
OAUTH_USERINFO_URL=http://185.61.210.32/api/oauth/userinfo
OAUTH_CLIENT_KEY=cppt-platform
# Prefer a read-only DSN for the Control Center apps table. The fallback is for local-only testing.
OAUTH_APPS_DSN=
OAUTH_REDIRECT_URI=http://127.0.0.1:3100/
CPPT_FRONTEND_URL=http://127.0.0.1:3100/
OAUTH_SESSION_SECRET=replace-with-at-least-32-byte-random-secret
OAUTH_SESSION_TTL_SECONDS=3600
OAUTH_STATE_TTL_SECONDS=600
OAUTH_HTTP_TIMEOUT_SECONDS=10
OAUTH_COOKIE_SECURE=false

XUNTUI_LLAMA_FACTORY_COMMAND=/opt/venvs/llamafactory/bin/llamafactory-cli
# Frontend public routing. Production should normally keep the same-origin defaults.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_INFERENCE_BASE_URL=
NEXT_PUBLIC_AUTH_CALLBACK_URL=/api/auth/callback
CPPT_DOCS_BACKEND_ORIGIN=http://127.0.0.1:8010

# 优云（CompShare）远程 GPU Provider
# 第一步只填公钥/私钥，然后运行 python -m backend.providers.youyun.check，
# 脚本会自动查出可用的区域、可用区和 CUDA 镜像并给出剩余配置行的建议值。
YOUYUN_API_BASE_URL=https://api.compshare.cn
YOUYUN_PUBLIC_KEY=
YOUYUN_PRIVATE_KEY=
YOUYUN_REGION=
YOUYUN_ZONE=
# 默认按整机实例运行；Pod 模式按容器实例可用区创建，并可直接复用公共模型库。
YOUYUN_INSTANCE_MODE=uhost
YOUYUN_POD_ZONE=
YOUYUN_PUBLIC_MODEL_ROOTS=/models,/model
# 训练默认使用社区 LLaMA-Factory 镜像；也可改成下方候选官方 CUDA/PyTorch/vLLM 镜像 ID。
YOUYUN_TRAINING_IMAGE_ID=compshareImage-1bvy5l0kjip2
# 推理服务默认镜像（需使用预装 vLLM 的镜像），与训练镜像分开配置。
YOUYUN_IMAGE_ID=
# 推理创建表单的默认镜像；留空即自动取优云最新官方 vLLM 镜像（推荐留空以跟随官方版本）。
YOUYUN_INFERENCE_IMAGE_ID=
YOUYUN_GPU_TYPE=4090
YOUYUN_CHARGE_TYPE=Postpay
# Provider candidate health guard for transient create errors (8433/226645).
XUNTUI_YOUYUN_RESOURCE_HEALTH_ENABLED=1
XUNTUI_YOUYUN_RESOURCE_HEALTH_COOLDOWN_SECONDS=300
YOUYUN_SSH_CONNECT_TIMEOUT_SECONDS=20
YOUYUN_SSH_READY_TIMEOUT_SECONDS=300
# 训练日志轮询遇到 SSH 瞬断时的重连次数与指数退避起始秒数。
YOUYUN_TRAINING_POLL_RETRIES=4
YOUYUN_TRAINING_POLL_BACKOFF_SECONDS=2
# 优云实例内预置或共享挂载的视觉基座模型根目录；可用冒号配置多个绝对路径。
# 目录中需包含 config.json、tokenizer_config.json、视觉 processor 配置和模型权重。
YOUYUN_BASE_MODEL_ROOT=/root/models
# 如果所有视觉任务共用一个固定模型目录，可直接填写；优先级高于根目录自动匹配。
# YOUYUN_BASE_MODEL_PATH=/root/models/Qwen2.5-VL-3B-Instruct
# 本地模型未命中时是否允许训练进程通过 ModelScope 在线下载；默认关闭，按需显式填 1。
YOUYUN_ALLOW_MODEL_DOWNLOAD=0
XUNTUI_REQUIRE_VISION_REMOTE_PROBE=1
# 优云推理在镜像/共享目录未命中时的 ModelScope 下载缓存目录。
YOUYUN_MODELSCOPE_CACHE=/root/cppt/modelscope-cache
# 只有列在这里、且实际存在于优云镜像或共享挂载目录中的 Repo ID 才会出现在远程视觉训练选择框。
# 多个模型用逗号分隔；未配置时优云视觉模型列表为空。
YOUYUN_BASE_MODEL_REPOS=
# 优云模型库视觉基模清单：可填 JSON/JSONL 文件路径，或直接填 JSON 内容。
# 清单条目支持 name、repoId、path、sizeGb、tags；应用会自动过滤非视觉模型。
# YOUYUN_BASE_MODEL_CATALOG=E:/cppt-platform/data/youyun-vision-catalog.json
# 文生图优先使用已验证的 Diffusers 应用镜像；留空时后端不会回退普通镜像。
XUNTUI_IMAGE_GENERATION_INFERENCE_IMAGE=
XUNTUI_DIFFUSERS_PYTHON=python3
XUNTUI_REMOTE_DIFFUSERS_INSTALL=0
XUNTUI_REMOTE_DIFFUSERS_PACKAGE=diffusers transformers accelerate datasets peft safetensors bitsandbytes modelscope
XUNTUI_REMOTE_DIFFUSERS_SENTINEL=/root/cppt/.cache/diffusers-ready
YOUYUN_MODEL_DOWNLOAD_WORKERS=4
XUNTUI_IMAGE_EVAL_CLIP_MODEL=openai/clip-vit-base-patch32
XUNTUI_REMOTE_IMAGE_EVAL_INSTALL=0
XUNTUI_REMOTE_IMAGE_EVAL_PACKAGE=transformers pillow
XUNTUI_SDXL_LORA_SCRIPT_URL=https://cdn.jsdelivr.net/gh/huggingface/diffusers@c9ff360966327ace3faad3807dc871a4e5447501/examples/text_to_image/train_text_to_image_lora_sdxl.py
# Backend-resolved, commit-addressed SDXL script artifact. MinIO is used before public fallback.
XUNTUI_SDXL_SCRIPT_ARTIFACT_ENABLED=1
XUNTUI_SDXL_SCRIPT_ARTIFACT_KEY=runtime-assets/diffusers/c9ff360966327ace3faad3807dc871a4e5447501/train_text_to_image_lora_sdxl.py
XUNTUI_SDXL_SCRIPT_LOCAL_PATH=
XUNTUI_SDXL_SCRIPT_CACHE=/workspace/runtime/sdxl-script-cache
XUNTUI_ALLOW_REMOTE_SCRIPT_DOWNLOAD=0
YOUYUN_SSH_READY_TIMEOUT_SECONDS=300
YOUYUN_SSH_CONNECT_RETRY_DELAY_SECONDS=5
# 优云推理默认只使用镜像内已验证的 vLLM 环境；确认依赖兼容后才改为 1 自动安装。
XUNTUI_REMOTE_VLLM_PYTHON=python3
XUNTUI_REMOTE_VLLM_INSTALL=0
XUNTUI_REMOTE_VLLM_PACKAGE=vllm
# 训练完成后保留实例的自动释放兜底：超过保留时长自动删除实例，避免持续计费。
# 对比请求会滑动续期保留窗口；设为更大值可延长人工对比时间。
XUNTUI_YOUYUN_RETENTION_HOURS=6
# 自动释放检查间隔（分钟）。
XUNTUI_YOUYUN_RETENTION_CHECK_MINUTES=5
XUNTUI_YOUYUN_RETENTION_CHECK_MINUTES=5
# Teacher/Judge (OpenAI-compatible; keep secrets server-side)
XUNTUI_EVALUATION_JUDGE_BASE_URL=
XUNTUI_EVALUATION_JUDGE_API_KEY=
XUNTUI_EVALUATION_JUDGE_MODEL=
# Optional semantic-similarity embeddings provider (OpenAI-compatible)
XUNTUI_EVALUATION_EMBEDDING_BASE_URL=
XUNTUI_EVALUATION_EMBEDDING_API_KEY=
XUNTUI_EVALUATION_EMBEDDING_MODEL=

# Remote logs: keep one lifecycle-owned SSH follower per remote run.
XUNTUI_REMOTE_LOG_FOLLOW_ENABLED=true

# Optional private CPU speech worker. Leave empty to disable. Never expose the key to browsers.
XUNTUI_SPEECH_WORKER_URL=
XUNTUI_SPEECH_WORKER_KEY=
